# Copy this file to .env.local and fill in real values.
# Never commit .env.local, it's already in .gitignore.

# --- Site ---
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Admin panel (MVP single-password auth) ---
# TODO: set a strong, unique password before deploying.
ADMIN_PASSWORD=changeme

# --- Session signing ---
# TODO: set a long random string (e.g. `openssl rand -hex 32`) before deploying.
SESSION_SECRET=dev-only-insecure-secret-change-me

# --- Stripe ---
# TODO: add real keys from https://dashboard.stripe.com/apikeys before launch.
STRIPE_SECRET_KEY=sk_test_placeholder
STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_placeholder
# TODO: get this from `stripe listen` locally, or the Stripe Dashboard in production.
STRIPE_WEBHOOK_SECRET=whsec_placeholder

# --- Resend (transactional email) ---
# TODO: add a real key from https://resend.com and verify your sending domain.
RESEND_API_KEY=
ADMIN_NOTIFICATION_EMAIL=hello@pet-carrier.co.uk

# --- Claude API (AI content rewriting for the Amazon import pipeline) ---
# TODO: add a real key from https://console.anthropic.com. Without it, the
# admin panel falls back to simple rule-based content generation.
ANTHROPIC_API_KEY=

# --- Keepa (Amazon price/stock sync) ---
# TODO: not yet active. Add a key from https://keepa.com/#!api once you're
# ready to wire up lib/products.ts -> syncProductWithKeepa().
KEEPA_API_KEY=

# --- Cloudflare R2 (production data + image persistence) ---
# Required in production: Vercel's serverless filesystem is read-only, so
# lib/data-store.ts and lib/image-store.ts write to R2 instead of /data and
# /public/uploads whenever these are set. Leave unset locally to keep using
# the JSON files on disk exactly as before.
#
# Two separate buckets on the same Cloudflare account:
#  - R2_BUCKET_NAME: public dev URL enabled, holds processed product/
#    category/hero images only, served directly via NEXT_PUBLIC_R2_PUBLIC_URL.
#  - R2_DATA_BUCKET_NAME: public access left OFF, holds the /data/*.json
#    files (customer emails, password hashes, orders). Never enable public
#    access on this bucket or point NEXT_PUBLIC_R2_PUBLIC_URL at it.
R2_ACCOUNT_ID=your_cloudflare_account_id
R2_ACCESS_KEY_ID=your_access_key
R2_SECRET_ACCESS_KEY=your_secret_key
R2_BUCKET_NAME=your_public_bucket_name
R2_DATA_BUCKET_NAME=your_private_data_bucket_name
NEXT_PUBLIC_R2_PUBLIC_URL=https://pub-xxxxx.r2.dev
